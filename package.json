{
  "name": "u-kirche",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:dev": "ng build --configuration development",
    "watch:dev": "ng build --watch --configuration development",
    "build:prod": "ng build --configuration production",
    "watch:prod": "ng build --watch --configuration production",
    "format": "npx prettier src --check",
    "format:fix": "npx prettier src --write",
    "deploy:dev": "npm run build:dev && firebase deploy --only hosting",
    "deploy:prod": "npm run build:prod && firebase deploy --only hosting --project prod",
    "serve:ssr:u-kirche": "node dist/u-kirche/server/server.mjs",
    "test:e2e": "npx playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "^19.0.2",
    "@angular/animations": "^19.2.17",
    "@angular/common": "^19.2.17",
    "@angular/compiler": "^19.2.17",
    "@angular/core": "^19.2.17",
    "@angular/forms": "^19.2.17",
    "@angular/platform-browser": "^19.2.17",
    "@angular/platform-browser-dynamic": "^19.2.17",
    "@angular/platform-server": "^19.2.17",
    "@angular/router": "^19.2.17",
    "@angular/ssr": "^19.2.19",
    "@fullcalendar/angular": "^6.1.17",
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngx-translate/core": "^16.0.3",
    "@ngx-translate/http-loader": "^16.0.0",
    "@primeng/themes": "^19.1.4",
    "express": "^4.18.2",
    "prettier": "^3.4.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primeng": "^19.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.19",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.2.17",
    "@playwright/test": "^1.49.1",
    "@types/express": "^4.17.17",
    "@types/node": "^18.18.0",
    "typescript": "~5.5.4"
  }
}
